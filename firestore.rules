rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Single-admin site. This UID is the only account that can create galleries,
    // upload photos, set prices or touch orders.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'OcjWZ7eZMkQf5tRdCFiBB7OvIoR2';
    }

    match /galleries/{galleryId} {
      // Public queries must filter on published == true; the admin reads drafts
      // by document id, which this same rule allows.
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();

      match /photos/{photoId} {
        allow read: if isAdmin()
                    || get(/databases/$(database)/documents/galleries/$(galleryId))
                         .data.published == true;
        allow write: if isAdmin();
      }
    }

    match /orders/{orderId} {
      // A buyer may only create an order for themselves, and only as pending --
      // marking an order paid is the admin's job.
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100
                    && request.resource.data.subtotalCents is int
                    && request.resource.data.subtotalCents >= 0;

      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.buyerUid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Contact-page enquiries. Anyone may send one; only the admin can read
    // them back. The size caps are the only spam brake -- if it ever gets
    // abused this needs a captcha or an auth requirement.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.handled == false
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1500;

      allow read, update, delete: if isAdmin();
    }

    // Download galleries for larger orders. The document id is the order id --
    // a 20-character random Firestore id -- and that id IS the access secret,
    // exactly like the Storage download links it contains. Anyone holding the
    // link can view and download; that is the same trust model the individual
    // emailed links already use. No buyer email is stored here.
    match /deliveries/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
